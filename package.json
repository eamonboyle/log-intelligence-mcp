{
  "name": "log-intelligence-mcp",
  "version": "1.0.0",
  "description": "AI Log Intelligence MCP Server - Consumes structured logs, detects anomalies, clusters errors, and identifies regressions",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "log-intelligence-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "logs",
    "log-analysis",
    "anomaly-detection",
    "error-clustering",
    "serilog",
    "elasticsearch",
    "sqlite",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "samples"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eamonboyle/log-intelligence-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/eamonboyle/log-intelligence-mcp/issues"
  },
  "homepage": "https://github.com/eamonboyle/log-intelligence-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "sql.js": "^1.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
